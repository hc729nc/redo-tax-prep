ANTHROPIC_API_KEY=
CLAUDE_MODEL_ID=claude-sonnet-4-5
DATABASE_URL=sqlite:///./synthia.db
STORAGE_ROOT=./uploads
TAX_YEAR=2025

# --- Only relevant for a real deployment (safe to leave unset for local dev) ---

# Signs session cookies. MUST be set to a fixed value in any real deployment -
# generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Leaving it unset is fine for local dev (a random one is generated per process),
# but means every session is invalidated on restart.
SECRET_KEY=

# Set to true once served over HTTPS (any real deployment). Must stay false for
# local dev over plain http://localhost.
COOKIE_SECURE=false

# Comma-separated list of frontend origins allowed to call this API. Only
# matters if the frontend is hosted separately from the backend - irrelevant if
# the backend serves the built frontend itself (see Dockerfile).
ALLOWED_ORIGINS=http://localhost:5173

# Per-user daily caps - abuse/cost protection for a publicly reachable deployment.
MAX_CHAT_MESSAGES_PER_DAY=60
MAX_UPLOADS_PER_DAY=30
